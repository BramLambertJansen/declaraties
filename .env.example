# Lokale demo-waarden. pnpm dev schrijft .env.local (fase 1). Nooit echte geheimen.
# Andere poort (tweede app op deze machine): de poortvariabelen én de poort in de drie database-URL's en SMTP_URL aanpassen.
# Compose leest dit bestand alleen met: docker compose --env-file .env.local …
# Rollen: zie db/init/01-roles.sql. Superuser alleen voor noodgevallen, nooit in scripts of src/.
# Beschermd bestand: buiten APP_ENV=local/test weigert het env-schema deze demo-waarden (framework §6).
APP_ENV=local
APP_ORIGIN=http://localhost:5173
PG_PORT=54322
MAIL_UI_PORT=54324
SMTP_PORT=54325

# Alleen scripts/ (migraties, snapshot, tests). dbmate: --env MIGRATOR_DATABASE_URL --no-dump-schema
MIGRATOR_DATABASE_URL=postgres://app_migrator:app_migrator@127.0.0.1:54322/app?sslmode=disable
# src/core/api/db (withUser)
DATABASE_URL=postgres://api_user:api_user@127.0.0.1:54322/app
# src/core/api/auth (Better Auth)
AUTH_DATABASE_URL=postgres://auth_service:auth_service@127.0.0.1:54322/app
AUTH_BASE_URL=http://localhost:5173
AUTH_SECRET=local-demo-secret-change-per-environment-000000
SMTP_URL=smtp://127.0.0.1:54325
