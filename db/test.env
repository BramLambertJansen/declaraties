# Test-stack voor de runner (ADR 0044): alleen op het interne netwerk test-net, geen poorten op de host.
# Lokale demo-waarden, nooit echt. scripts/runner.sh geeft dit bestand altijd mee (nooit .env.local).
APP_ENV=test
DATABASE_URL=postgres://api_user:api_user@test-db:5432/app
AUTH_DATABASE_URL=postgres://auth_service:auth_service@test-db:5432/app
MIGRATOR_DATABASE_URL=postgres://app_migrator:app_migrator@test-db:5432/app?sslmode=disable
# Dezelfde rol via PgBouncer in transaction mode (ADR 0042).
POOLER_DATABASE_URL=postgres://api_user:api_user@test-pooler:5432/app
# Volledige env voor de API-server in ui:check (env-schema, framework §6). Demo-waarden; APP_ENV=test staat ze toe.
APP_ORIGIN=http://localhost:5173
AUTH_BASE_URL=http://localhost:5173
AUTH_SECRET=test-demo-secret-change-per-environment-000000
SMTP_URL=smtp://test-mailpit:1025
# Mailpit-API voor de auth-tests (uitnodigingsmail ophalen).
MAILPIT_URL=http://test-mailpit:8025
# Header met het client-IP (rate limit per client in de auth-tests).
CLIENT_IP_HEADER=x-test-client-ip
