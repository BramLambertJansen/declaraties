{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/api",
    "src/core/api",
    "src/shared",
    "src/core/shared",
    "e2e",
    "test",
    "scripts",
    ".claude/hooks",
    "rails",
    "*.config.ts"
  ],
  "exclude": ["test/rails/fixtures"]
}
