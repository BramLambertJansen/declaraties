{
  "name": "app-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=26.11 <27"
  },
  "browserslist": [
    "safari >= 16.4",
    "chrome >= 111",
    "firefox >= 128"
  ],
  "imports": {
    "#core/*": "./src/core/*",
    "#api/*": "./src/api/*",
    "#web/*": "./src/web/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node src/api/server.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --write",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --check",
    "typecheck": "tsc -b",
    "ratchet": "node scripts/kit/ratchet.mjs",
    "ratchet:update": "node scripts/kit/ratchet.mjs --update",
    "check:catalogus": "node scripts/kit/catalogus.mjs",
    "check:migrations": "node scripts/kit/check-migrations.mjs",
    "check:docs-drift": "node scripts/kit/check-docs-drift.mjs",
    "check:secdef": "node scripts/kit/check-secdef.mjs",
    "check:new-resource": "node scripts/kit/check-new-resource.mjs",
    "test:unit": "vitest run --project unit --project web",
    "test:db": "scripts/runner.sh db",
    "test:e2e": "playwright test",
    "ui:check": "scripts/runner.sh ui",
    "db:migrate": "scripts/db-migrate.sh .env.local up",
    "db:generate": "scripts/db-generate.sh",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/admin-create.mjs",
    "auth:schema": "node scripts/auth-schema.mjs",
    "new:resource": "node scripts/kit/new-resource.mjs",
    "app:init": "node scripts/kit/app-init.mjs",
    "gate:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm ratchet && pnpm check:catalogus && pnpm check:migrations && pnpm check:secdef && pnpm test:unit",
    "check:snapshot": "scripts/check-snapshot.sh",
    "gate:slow": "pnpm test:db && pnpm ui:check && pnpm check:snapshot"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "lucide-react": "1.50.0",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
