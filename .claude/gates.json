{
  "$comment": "Enige lijst met gate-paden (framework §8 en §10, ADR 0011). De rolhek-hook leest hem lokaal; CODEOWNERS en `ask` in .claude/settings.json spiegelen hem (test/hooks/gates-json.test.ts); de diff-guard in CI leest hem (roadmap stuk 4). Globs: `*` binnen één map, `**` over mappen heen. `mcpLezen`: exacte namen van read-only MCP-tools die het rolhek doorlaat; elke andere `mcp__`-tool is ask (hoofdsessie) of deny (subagent).",
  "gates": [
    "AGENTS.md",
    "CLAUDE.md",
    "docs/framework.md",
    "docs/dod.md",
    "docs/roadmap.md",
    "docs/adr/**",
    "docs/specs/**",
    ".github/**",
    ".claude/**",
    "scripts/**",
    "db/init/**",
    "db/docker/**",
    "db/tests/**",
    "compose*.yaml",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    ".pnpmfile.cjs",
    "mise.toml",
    ".env.example",
    "eslint.config.*",
    "eslint-suppressions.json",
    ".kit/**",
    "osv-scanner.toml",
    ".betterleaksignore",
    "tsconfig*.json",
    ".dependency-cruiser.*",
    "lefthook.yml",
    "renovate.json",
    ".gitattributes",
    "src/core/**",
    "src/api/app.ts",
    "src/api/kit.ts",
    "src/api/server.ts",
    "src/api/env.ts",
    "src/shared/permissions.ts",
    "deploy/**",
    "**/*.test.*",
    "**/*.spec.*",
    "e2e/**"
  ],
  "testpaden": ["**/*.test.*", "**/*.spec.*", "e2e/**", "db/tests/**", "test/**"],
  "jsonGates": { "package.json": ["scripts"] },
  "gegenereerd": ["src/web/routeTree.gen.ts", "src/api/db/schema.ts", "db/schema.snapshot.sql"],
  "migraties": ["db/migrations/**"],
  "mcpLezen": [],
  "goedkeurders": ["bramlambertjansen"],
  "schrijfrecht": {
    "architect": ["docs/specs/**", "docs/adr/**"],
    "tester": ["**/*.test.*", "**/*.spec.*", "e2e/**", "db/tests/**", "test/**"],
    "reviewer": [],
    "docs": ["docs/**", "README.md", "CHANGELOG.md"],
    "developer": ["**"]
  }
}
