{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(/*secret*)",
      "Read(./.claude/*secret*)",
      "Read(./.claude/agents/**/*secret*)",
      "Read(./.claude/hooks/**/*secret*)",
      "Read(./.claude/rules/**/*secret*)",
      "Read(./.claude/skills/**/*secret*)",
      "Read(./.github/**/*secret*)",
      "Read(./.kit/**/*secret*)",
      "Read(./.vscode/**/*secret*)",
      "Read(./db/**/*secret*)",
      "Read(./deploy/**/*secret*)",
      "Read(./designs/**/*secret*)",
      "Read(./docs/**/*secret*)",
      "Read(./e2e/**/*secret*)",
      "Read(./rails/**/*secret*)",
      "Read(./scripts/**/*secret*)",
      "Read(./src/**/*secret*)",
      "Read(./test/**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(gh pr review*)",
      "Bash(gh * --add-label*gate-wijziging*)",
      "Bash(gh api *statuses*)",
      "Bash(gh api *check-runs*)",
      "Bash(gh api *reviews*)",
      "Bash(LEFTHOOK=0 *)",
      "Bash(LEFTHOOK_EXCLUDE=*)",
      "Bash(docker *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm run format)",
      "Bash(pnpm run format *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm upgrade *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm uninstall *)",
      "Bash(pnpm un *)",
      "Bash(pnpm test:db *)",
      "Bash(pnpm ui:check *)",
      "Bash(pnpm gate:slow *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm check:snapshot *)",
      "Bash(pnpm new:resource *)",
      "Bash(pnpm run new:resource *)",
      "Bash(sed -i *)",
      "Bash(perl -pi *)",
      "Edit(.github/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/gates.json)",
      "Edit(.claude/decisions.json)",
      "Edit(package.json)",
      "Edit(pnpm-lock.yaml)"
    ],
    "allow": [
      "Bash(git push origin chore/mandate-adr-statusregel)",
      "Bash(gh pr create:*)",
      "Bash(node scripts/kit/feiten.mjs)",
      "Bash(node scripts/kit/feiten.mjs *)",
      "Bash(pnpm gate:fast)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm ratchet)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm check:catalogus)",
      "Bash(pnpm check:migrations)",
      "Bash(pnpm check:secdef)",
      "Bash(pnpm check:roadmap)",
      "Bash(pnpm check:docs-drift)",
      "Bash(pnpm pr:verify *)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin test/*)",
      "Bash(git push origin refactor/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "pnpm test:db *",
      "pnpm ui:check *",
      "pnpm gate:slow *",
      "pnpm db:generate *",
      "pnpm check:snapshot *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ],
      "allowRead": ["./.env.example"]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rolhek.mjs\"", "timeout": 10 }]
      },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }
    ],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PermissionDenied": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" post-edit", "timeout": 60 }] }, { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" stop", "timeout": 300 }] }, { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "SubagentStop": [{ "matcher": "developer|tester|reviewer", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" subagent-stop", "timeout": 600 }] }],
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" session-start", "timeout": 30 }] }]
  }
}
