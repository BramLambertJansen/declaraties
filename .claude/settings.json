{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(./*secret*)",
      "Read(./.claude/**/*secret*)",
      "Read(./.github/**/*secret*)",
      "Read(./.kit/**/*secret*)",
      "Read(./.vscode/**/*secret*)",
      "Read(./db/**/*secret*)",
      "Read(./deploy/**/*secret*)",
      "Read(./designs/**/*secret*)",
      "Read(./docs/**/*secret*)",
      "Read(./e2e/**/*secret*)",
      "Read(./scripts/**/*secret*)",
      "Read(./src/**/*secret*)",
      "Read(./test/**/*secret*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(gh pr review*)",
      "Bash(gh * --add-label*gate-wijziging*)",
      "Bash(gh api *statuses*)",
      "Bash(gh api *check-runs*)",
      "Bash(gh api *reviews*)",
      "Bash(LEFTHOOK=0 *)",
      "Bash(LEFTHOOK_EXCLUDE=*)",
      "Bash(docker *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm upgrade *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm uninstall *)",
      "Bash(pnpm un *)",
      "Bash(pnpm test:db *)",
      "Bash(pnpm ui:check *)",
      "Bash(pnpm gate:slow *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm check:snapshot *)",
      "Bash(pnpm new:resource *)",
      "Bash(pnpm run new:resource *)",
      "Bash(sed -i *)",
      "Bash(perl -pi *)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(docs/framework.md)",
      "Edit(docs/dod.md)",
      "Edit(docs/roadmap.md)",
      "Edit(docs/adr/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(db/init/**)",
      "Edit(db/docker/**)",
      "Edit(compose*.yaml)",
      "Edit(package.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(pnpm-workspace.yaml)",
      "Edit(.npmrc)",
      "Edit(.pnpmfile.cjs)",
      "Edit(mise.toml)",
      "Edit(.env.example)",
      "Edit(eslint.config.*)",
      "Edit(eslint-suppressions.json)",
      "Edit(.kit/**)",
      "Edit(osv-scanner.toml)",
      "Edit(.betterleaksignore)",
      "Edit(tsconfig*.json)",
      "Edit(.dependency-cruiser.*)",
      "Edit(lefthook.yml)",
      "Edit(renovate.json)",
      "Edit(src/core/**)",
      "Edit(src/api/app.ts)",
      "Edit(src/api/kit.ts)",
      "Edit(src/api/server.ts)",
      "Edit(src/api/env.ts)",
      "Edit(src/shared/permissions.ts)",
      "Edit(deploy/**)",
      "Edit(.gitattributes)",
      "Edit(vitest.config.ts)",
      "Edit(playwright.config.ts)",
      "Edit(vite.config.ts)",
      "Edit(.prettierrc.json)",
      "Edit(.prettierignore)",
      "Edit(Dockerfile)",
      "Edit(.dockerignore)",
      "Edit(db/test.env)",
      "Edit(docs/nieuwe-app.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "pnpm test:db *",
      "pnpm ui:check *",
      "pnpm gate:slow *",
      "pnpm db:generate *",
      "pnpm check:snapshot *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws"
      ],
      "allowRead": ["./.env.example"]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rolhek.mjs\"", "timeout": 10 }]
      },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }
    ],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PermissionDenied": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" post-edit", "timeout": 60 }] }, { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" stop", "timeout": 300 }] }, { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/meting.mjs\"", "timeout": 5 }] }],
    "SubagentStop": [{ "matcher": "developer|tester|reviewer", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" subagent-stop", "timeout": 600 }] }],
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkstraat.mjs\" session-start", "timeout": 30 }] }]
  }
}
