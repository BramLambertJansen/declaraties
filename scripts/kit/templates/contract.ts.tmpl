import { z } from 'zod';
import { pageSchema } from '#core/shared/cursor.ts';
import { __Naam__Id } from '../ids.ts';
import { defineContract } from './kit.ts';

// Resource __naam__ (spec docs/specs/__naam__.md), gemaakt door pnpm new:resource.
// Lijst met cursor, aanmaken, wijzigen en verwijderen. De velden komen uit de spec: in het item en in de invoer van
// aanmaken en wijzigen, met grenzen uit limits.ts.
// Rate limit (spec rate-limit): zonder `rateLimit` geldt de standaard per methode (GET → 'lezen', anders 'schrijven');
// een route die mail verstuurt of iets anders duurs doet, krijgt `rateLimit: 'duur'`.
export const __naamCamel__Item = z
  .object({
    id: __Naam__Id,
    // ISO 8601 met tijdzone; tonen via format.dateTime.
    aangemaakt: z.string(),
  })
  .strict();

export const __naamCamel__ListContract = defineContract({
  method: 'GET',
  path: '/__naam__',
  input: z.object({ cursor: z.string().max(500).optional() }).strict(),
  output: pageSchema(__naamCamel__Item),
  permission: '__naam__:read',
});

export const __naamCamel__CreateInput = z.object({}).strict();

export const __naamCamel__CreateContract = defineContract({
  method: 'POST',
  path: '/__naam__',
  input: __naamCamel__CreateInput,
  output: z.object({ id: __Naam__Id }).strict(),
  permission: '__naam__:write',
});

export const __naamCamel__UpdateInput = z.object({ id: __Naam__Id }).strict();

export const __naamCamel__UpdateContract = defineContract({
  method: 'PATCH',
  path: '/__naam__/:id',
  input: __naamCamel__UpdateInput,
  output: z.null(),
  permission: '__naam__:write',
});

export const __naamCamel__DeleteContract = defineContract({
  method: 'DELETE',
  path: '/__naam__/:id',
  input: z.object({ id: __Naam__Id }).strict(),
  output: z.null(),
  permission: '__naam__:write',
});
