{
  "deny": [
    "Read(.env)",
    "Read(.env.*)",
    "Edit(.env)",
    "Edit(.env.*)",
    "Read(/*secret*)",
    "Read(./.claude/*secret*)",
    "Read(./.claude/agents/**/*secret*)",
    "Read(./.claude/hooks/**/*secret*)",
    "Read(./.claude/rules/**/*secret*)",
    "Read(./.claude/skills/**/*secret*)",
    "Read(./.github/**/*secret*)",
    "Read(./.kit/**/*secret*)",
    "Read(./.vscode/**/*secret*)",
    "Read(./db/**/*secret*)",
    "Read(./deploy/**/*secret*)",
    "Read(./designs/**/*secret*)",
    "Read(./docs/**/*secret*)",
    "Read(./e2e/**/*secret*)",
    "Read(./rails/**/*secret*)",
    "Read(./scripts/**/*secret*)",
    "Read(./src/**/*secret*)",
    "Read(./test/**/*secret*)",
    "Read(~/.ssh/**)",
    "Read(~/.aws/**)",
    "Bash(git push origin main)",
    "Bash(git push origin main *)",
    "Bash(git push * main)",
    "Bash(git push *:main)",
    "Bash(git push *:main *)",
    "Bash(git push * +main)",
    "Bash(git push * +main *)",
    "Bash(git push * main *)",
    "Bash(git push *refs/heads/main)",
    "Bash(git push *refs/heads/main *)",
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(git push * --force*)",
    "Bash(git push * -f*)",
    "Bash(git * --no-verify*)",
    "Bash(git commit -n*)",
    "Bash(git commit * -n)",
    "Bash(git -c core.hooksPath*)",
    "Bash(git config core.hooksPath*)",
    "Bash(gh pr merge*)",
    "Bash(gh api *merge*)",
    "Bash(gh pr review*)",
    "Bash(gh * --add-label*gate-wijziging*)",
    "Bash(gh api *statuses*)",
    "Bash(gh api *check-runs*)",
    "Bash(gh api *reviews*)",
    "Bash(LEFTHOOK=0 *)",
    "Bash(LEFTHOOK_EXCLUDE=*)",
    "Bash(docker *)"
  ],
  "ask": [
    "Bash(pnpm format)",
    "Bash(pnpm format *)",
    "Bash(pnpm run format)",
    "Bash(pnpm run format *)",
    "Bash(pnpm add *)",
    "Bash(pnpm install *)",
    "Bash(pnpm i *)",
    "Bash(pnpm update *)",
    "Bash(pnpm up *)",
    "Bash(pnpm upgrade *)",
    "Bash(pnpm remove *)",
    "Bash(pnpm rm *)",
    "Bash(pnpm uninstall *)",
    "Bash(pnpm un *)",
    "Bash(pnpm test:db *)",
    "Bash(pnpm ui:check *)",
    "Bash(pnpm gate:slow *)",
    "Bash(pnpm db:generate *)",
    "Bash(pnpm check:snapshot *)",
    "Bash(pnpm new:resource *)",
    "Bash(pnpm run new:resource *)",
    "Bash(pnpm pr:merge *)",
    "Bash(sed -i *)",
    "Bash(perl -pi *)",
    "Edit(.github/**)",
    "Edit(.claude/hooks/**)",
    "Edit(.claude/settings.json)",
    "Edit(.claude/gates.json)",
    "Edit(.claude/decisions.json)",
    "Edit(package.json)",
    "Edit(pnpm-lock.yaml)"
  ],
  "excludedCommands": [
    "pnpm pr:merge *",
    "pnpm test:db *",
    "pnpm ui:check *",
    "pnpm gate:slow *",
    "pnpm db:generate *",
    "pnpm check:snapshot *",
    "pnpm rolhek:overnemen *"
  ],
  "network": {
    "allowedDomains": ["registry.npmjs.org", "github.com", "api.github.com"]
  },
  "allowRead": ["./.env.example"],
  "denyRead": ["~/.ssh", "~/.aws"],
  "workspace": "# Eén pakket; dit bestand bestaat voor de pnpm-instellingen (supply chain, docs/framework.md §6).\npackages:\n  - \".\"\n\n# Weiger een afwijkende installatie vóór run/exec; herstel alleen via een expliciete install.\nverifyDepsBeforeRun: error\n\n# Nieuwe versies pas na 7 dagen (in minuten).\nminimumReleaseAge: 10080\n# Weiger een versie die met minder vertrouwen gepubliceerd is dan de vorige.\ntrustPolicy: no-downgrade\n# Uitzonderingen per exacte versie, met reden (akkoord eigenaar):\n# - semver@6.3.1 (via @babel/core van @tanstack/router-plugin): de beveiligingspatch (CVE-2022-25883) op de oude 6.x-tak,\n#   gepubliceerd zonder provenance na een 7.x met provenance; geen overname.\ntrustPolicyExclude:\n  - semver@6.3.1\n# Install-scripts alleen voor expliciet toegestane pakketten.\nstrictDepBuilds: true\n# lefthook: geen postinstall; scripts/bootstrap.sh draait `lefthook install` zelf.\nallowBuilds:\n  lefthook: false\n# node_modules zonder symlinks buiten de repo: de runner mount alleen de repo (ADR 0044).\nenableGlobalVirtualStore: false\nminimumReleaseAgeExclude:\n  - nodemailer@10.1.4\n"
}
